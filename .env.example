# Copie este arquivo para .env e preencha. O .env NUNCA vai para o Git.

# ── Banco de dados (também lido pelo docker-compose.yml) ──
POSTGRES_USER=admin
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=grips_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# ── IA (Google AI Studio) ──
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.6-flash

# ── Rede (opcional; estes são os valores padrão) ──
# GRIPS_API_URL=http://localhost:8000
# CORS_ORIGINS=http://localhost:8501,http://127.0.0.1:8501
